# Leave EMPTY for local dev (vite proxies /api -> http://localhost:8080)
# Production build: full URL of the deployed Spring Boot API, no trailing slash
VITE_API_BASE_URL=https://sparkle26-backend.onrender.com

# GPay / UPI collection account (the number/ID that receives the money)
# e.g. VITE_UPI_ID=9876543210@okhdfcbank   (GPay -> Profile -> UPI IDs)
# If empty, /public/gpay-qr.png (your static GPay QR image) is shown instead.
VITE_UPI_ID=
VITE_UPI_NAME=SPARKLE'26
