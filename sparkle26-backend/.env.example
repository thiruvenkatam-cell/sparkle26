# Supabase -> Connect -> "Session pooler" (IPv4 ku idhu thaan, free)
DB_URL=jdbc:postgresql://aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require&prepareThreshold=0
# username = postgres.<PROJECT-REF>   (plain "postgres" illa!)
DB_USERNAME=postgres.PROJECTREF
DB_PASSWORD=
DDL_AUTO=update

GMAIL_USER=
GMAIL_APP_PASSWORD=

VOLUNTEER_API_KEY=
ADMIN_API_KEY=

SITE_URL=https://your-college-subdomain
APP_ALLOWED_ORIGINS=https://your-college-subdomain,https://your-checkin-url
